{
  "schemaVersion": 1,
  "id": "david.macnook",
  "name": "MacNook",
  "version": "1.0.0",
  "author": "David",
  "description": "A bar drawer for notched Omarchy panels. Collapse widgets you rarely touch into a tray that opens below the bar, sits flush on the camera shelf, and never covers the bar. Drag widgets in and out.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "MacNook",
    "description": "A bar drawer for notched Omarchy panels. Collapse widgets you rarely touch into a tray that opens below the bar rather than along it. Drag widgets in and out.",
    "category": "Layout",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "items": [],
      "trigger": "hover",
      "duration": 180,
      "hideAfter": 10000
    },
    "schema": [
      {
        "key": "trigger",
        "type": "enum",
        "label": "Open on",
        "options": [
          "hover",
          "click"
        ],
        "defaultValue": "hover"
      },
      {
        "key": "duration",
        "type": "integer",
        "label": "Reveal duration (ms)",
        "min": 0,
        "max": 1000,
        "defaultValue": 180
      },
      {
        "key": "hideAfter",
        "type": "integer",
        "label": "Hide after (ms)",
        "min": 0,
        "max": 600000,
        "defaultValue": 10000
      }
    ]
  },
  "license": "MIT"
}
